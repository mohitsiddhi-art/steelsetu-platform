datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES
  STORE
  SELLER
  BUYER
  BROKER
  MODERATOR
  COMMUNITY_MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CompanyType {
  PROPRIETORSHIP
  PARTNERSHIP
  PVT_LTD
  PUBLIC_LTD
  LLP
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum RFQStatus {
  DRAFT
  OPEN
  QUOTED
  CLOSED
  CANCELLED
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  REVISED
}

enum OrderStatus {
  PLACED
  UNDER_ADMIN_REVIEW
  ASSIGNED_TO_SELLER
  ACCEPTED_BY_SELLER
  REJECTED_BY_SELLER
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum PaymentMode {
  CASH
  UPI
  NEFT_RTGS
  CHEQUE
  DD
  ONLINE_RAZORPAY
  CREDIT_ADJUSTMENT
}

enum InvoiceType {
  PROFORMA
  TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALES_DISPATCH
  SALES_RETURN
  PURCHASE_RETURN
  MANUAL_ADJUSTMENT
  DAMAGE_LOSS
}

enum PartyType {
  CUSTOMER
  VENDOR
  BOTH
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum JoinPolicy {
  OPEN
  APPROVAL_REQUIRED
  INVITE_ONLY
}

enum MemberRole {
  COMMUNITY_ADMIN
  COMMUNITY_MODERATOR
  COMMUNITY_MEMBER
}

enum PostType {
  DISCUSSION
  QUESTION
  SUGGESTION
}

enum SuggestionStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  DONE
  CLOSED
}

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
  INTERESTED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintType {
  BRAND
  PRODUCT
  SELLER
  SERVICE
  PLATFORM
}

enum NewsCategory {
  MARKET_TRENDS
  PRICE_ANALYSIS
  GOVERNMENT_POLICY
  TECH_INNOVATION
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                   String                 @id @default(uuid())
  phoneNumber          String                 @unique
  email                String?                @unique
  passwordHash         String
  fullName             String
  role                 UserRole               @default(BUYER)
  status               UserStatus             @default(PENDING)
  preferredLanguage    String                 @default("en")
  profilePicUrl        String?
  lastLoginAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?

  companyId            String?
  company              Company?               @relation(fields: [companyId], references: [id])
  sessions             Session[]
  auditLogs            AuditLog[]
  rfqsRaised           RFQ[]                  @relation("BuyerRFQs")
  quotationsCreated    Quotation[]            @relation("CreatedQuotations")
  ordersAsBuyer        Order[]                @relation("BuyerOrders")
  ordersAssigned       Order[]                @relation("AssignedSellerOrders")
  communityMemberships CommunityMember[]
  posts                Post[]
  comments             Comment[]
  postReactions        PostReaction[]
  pollVotes            PollVote[]
  eventRSVPs           EventRSVP[]
  sentInvites          CommunityInvitation[]  @relation("InvitedBy")
  joinRequests         JoinRequest[]
  complaintsRaised     Complaint[]            @relation("Complainant")
  tasks                Task[]

  @@index([phoneNumber])
  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Company {
  id                  String             @id @default(uuid())
  legalName           String
  brandName           String?
  companyType         CompanyType        @default(PROPRIETORSHIP)
  gstin               String?            @unique
  pan                 String?            @unique
  tradeLicenseNo      String?
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  verificationNotes   String?
  isFeatured          Boolean            @default(false)
  yearsInBusiness     Int?
  registeredAddress   String
  city                String             @default("Kolkata")
  state               String             @default("West Bengal")
  pincode             String
  areaMarket          String?            @default("Burrabazar")
  profileCompleteness Int                @default(20)
  logoUrl             String?
  bannerUrl           String?
  aboutUs             String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  users               User[]
  verificationDocs    VerificationDoc[]
  productOffers       ProductOffer[]
  parties             CustomerVendorParty[]
  purchases           Purchase[]

  @@index([verificationStatus])
  @@index([city, state])
  @@index([brandName])
}

model VerificationDoc {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docType    String
  fileUrl    String
  isVerified Boolean  @default(false)
  uploadedAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actor        User     @relation(fields: [actorId], references: [id])
  role         UserRole
  action       String
  targetEntity String
  targetId     String
  ipAddress    String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetEntity, targetId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  hsnCode     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id              String    @id @default(uuid())
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?    @relation(fields: [brandId], references: [id])
  name            String
  slug            String    @unique
  uom             String    @default("Kg")
  specifications  Json?
  imageUrl        String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  offers          ProductOffer[]
  dailyRates      DailyRate[]

  @@index([categoryId])
  @@index([brandId])
}

model ProductOffer {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  sellerId      String
  seller        Company   @relation(fields: [sellerId], references: [id])
  pricePerUnit  Decimal   @db.Decimal(12, 2)
  labourCharges Decimal   @default(0.00) @db.Decimal(10, 2)
  availableQty  Decimal   @db.Decimal(12, 3)
  minOrderQty   Decimal   @default(1.000) @db.Decimal(12, 3)
  isAvailable   Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  city          String    @default("Kolkata")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stockMovements StockMovement[]

  @@unique([productId, sellerId])
  @@index([sellerId])
}

model DailyRate {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  retailRate    Decimal  @db.Decimal(12, 2)
  wholesaleRate Decimal  @db.Decimal(12, 2)
  effectiveDate DateTime @default(now())
  updatedBy     String
  createdAt     DateTime @default(now())

  rateHistory   PriceHistory[]

  @@index([productId, effectiveDate])
}

model PriceHistory {
  id           String    @id @default(uuid())
  dailyRateId  String
  dailyRate    DailyRate @relation(fields: [dailyRateId], references: [id], onDelete: Cascade)
  oldRetail    Decimal   @db.Decimal(12, 2)
  newRetail    Decimal   @db.Decimal(12, 2)
  oldWholesale Decimal   @db.Decimal(12, 2)
  newWholesale Decimal   @db.Decimal(12, 2)
  changedAt    DateTime  @default(now())
  changedBy    String
}

model RFQ {
  id               String      @id @default(uuid())
  rfqNumber        String      @unique
  buyerId          String
  buyer            User        @relation("BuyerRFQs", fields: [buyerId], references: [id])
  status           RFQStatus   @default(OPEN)
  deliveryLocation String
  deliveryPincode  String
  requiredByDate   DateTime?
  notes            String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items            RFQItem[]
  quotations       Quotation[]

  @@index([buyerId])
  @@index([status])
}

model RFQItem {
  id          String   @id @default(uuid())
  rfqId       String
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productName String
  thickness   String?
  brandPref   String?
  quantity    Decimal  @db.Decimal(12, 3)
  uom         String   @default("Kg")
  notes       String?
}

model Quotation {
  id          String          @id @default(uuid())
  quoteNumber String          @unique
  rfqId       String?
  rfq         RFQ?            @relation(fields: [rfqId], references: [id])
  createdById String
  createdBy   User            @relation("CreatedQuotations", fields: [createdById], references: [id])
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime
  subTotal    Decimal         @db.Decimal(12, 2)
  taxTotal    Decimal         @db.Decimal(12, 2)
  grandTotal  Decimal         @db.Decimal(12, 2)
  terms       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items       QuotationItem[]
  orders      Order[]

  @@index([rfqId])
  @@index([createdById])
}

model QuotationItem {
  id            String    @id @default(uuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description   String
  quantity      Decimal   @db.Decimal(12, 3)
  unitPrice     Decimal   @db.Decimal(12, 2)
  labourRate    Decimal   @default(0.00) @db.Decimal(10, 2)
  taxPercentage Decimal   @db.Decimal(5, 2)
  totalAmount   Decimal   @db.Decimal(12, 2)
}

model Order {
  id               String         @id @default(uuid())
  orderNumber      String         @unique
  quotationId      String?
  quotation        Quotation?     @relation(fields: [quotationId], references: [id])
  buyerId          String
  buyer            User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  assignedSellerId String?
  assignedSeller   User?          @relation("AssignedSellerOrders", fields: [assignedSellerId], references: [id])
  status           OrderStatus    @default(PLACED)
  deliveryAddress  String
  vehicleNumber    String?
  transporterName  String?
  lrNumber         String?
  dispatchDate     DateTime?
  subTotal         Decimal        @db.Decimal(12, 2)
  cgstAmount       Decimal        @default(0.00) @db.Decimal(12, 2)
  sgstAmount       Decimal        @default(0.00) @db.Decimal(12, 2)
  igstAmount       Decimal        @default(0.00) @db.Decimal(12, 2)
  grandTotal       Decimal        @db.Decimal(12, 2)
  commissionAmount Decimal        @default(0.00) @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  invoices         Invoice[]
  payments         Payment[]
  complaints       Complaint[]
  lorryReceipts    LorryReceipt[]

  @@index([buyerId])
  @@index([assignedSellerId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  labourRate  Decimal  @default(0.00) @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(12, 2)
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  remarks    String?
  changedBy  String
  createdAt  DateTime    @default(now())
}

model Invoice {
  id            String      @id @default(uuid())
  invoiceNumber String      @unique
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id])
  invoiceType   InvoiceType @default(TAX_INVOICE)
  invoiceDate   DateTime    @default(now())
  dueDate       DateTime
  sellerGSTIN   String
  buyerGSTIN    String?
  placeOfSupply String
  isIntraState  Boolean     @default(true)
  subTotal      Decimal     @db.Decimal(12, 2)
  cgstTotal     Decimal     @db.Decimal(12, 2)
  sgstTotal     Decimal     @db.Decimal(12, 2)
  igstTotal     Decimal     @db.Decimal(12, 2)
  grandTotal    Decimal     @db.Decimal(12, 2)
  paidAmount    Decimal     @default(0.00) @db.Decimal(12, 2)
  pdfUrl        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items         InvoiceItem[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]

  @@index([orderId])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnCode     String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  taxableVal  Decimal  @db.Decimal(12, 2)
  totalVal    Decimal  @db.Decimal(12, 2)
}

model CustomerVendorParty {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  partyType      PartyType @default(CUSTOMER)
  name           String
  gstin          String?
  phone          String
  email          String?
  billingAddress String
  creditLimit    Decimal   @default(0.00) @db.Decimal(12, 2)
  creditDays     Int       @default(30)
  currentBalance Decimal   @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ledgerEntries  LedgerEntry[]
  purchases      Purchase[]
  tasks          Task[]

  @@index([companyId])
  @@index([partyType])
}

model Payment {
  id             String        @id @default(uuid())
  paymentNo      String        @unique
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id])
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  mode           PaymentMode
  status         PaymentStatus @default(PENDING)
  transactionRef String?
  paymentDate    DateTime      @default(now())
  remarks        String?
  createdAt      DateTime      @default(now())

  ledgerEntries  LedgerEntry[]

  @@index([orderId])
  @@index([invoiceId])
}

model LedgerEntry {
  id           String              @id @default(uuid())
  partyId      String
  party        CustomerVendorParty @relation(fields: [partyId], references: [id])
  invoiceId    String?
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id])
  paymentId    String?
  payment      Payment?            @relation(fields: [paymentId], references: [id])
  entryDate    DateTime            @default(now())
  voucherType  String
  debitAmount  Decimal             @default(0.00) @db.Decimal(12, 2)
  creditAmount Decimal             @default(0.00) @db.Decimal(12, 2)
  balance      Decimal             @db.Decimal(12, 2)
  narration    String
  createdAt    DateTime            @default(now())

  @@index([partyId, entryDate])
}

model StockMovement {
  id             String            @id @default(uuid())
  productOfferId String
  productOffer   ProductOffer      @relation(fields: [productOfferId], references: [id])
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  referenceNo    String?
  remarks        String?
  createdAt      DateTime          @default(now())
  createdBy      String

  @@index([productOfferId])
}

model Purchase {
  id           String              @id @default(uuid())
  purchaseNo   String              @unique
  vendorId     String
  vendor       CustomerVendorParty @relation(fields: [vendorId], references: [id])
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  purchaseDate DateTime            @default(now())
  totalAmount  Decimal             @db.Decimal(12, 2)
  grnNumber    String?
  createdAt    DateTime            @default(now())

  items        PurchaseItem[]

  @@index([vendorId])
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
}

model Expense {
  id          String   @id @default(uuid())
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  payee       String
  expenseDate DateTime @default(now())
  receiptUrl  String?
  gstAmount   Decimal  @default(0.00) @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
}

model Task {
  id           String              @id @default(uuid())
  title        String
  description  String?             @db.Text
  status       TaskStatus          @default(PENDING)
  priority     TaskPriority        @default(MEDIUM)
  dueDate      DateTime?
  assignedToId String
  assignedTo   User                @relation(fields: [assignedToId], references: [id])
  partyId      String?
  party        CustomerVendorParty? @relation(fields: [partyId], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([assignedToId])
  @@index([status])
}

model LorryReceipt {
  id              String   @id @default(uuid())
  lrNumber        String   @unique
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  transporterName String
  vehicleNumber   String
  driverName      String?
  driverPhone     String?
  eWayBillNo      String?
  freightCharges  Decimal  @default(0.00) @db.Decimal(10, 2)
  dispatchDate    DateTime @default(now())
  deliveryAddress String
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([lrNumber])
}

model PromotionalOffer {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  discountPct  Decimal? @db.Decimal(5, 2)
  flatDiscount Decimal? @db.Decimal(10, 2)
  validFrom    DateTime
  validUntil   DateTime
  maxUses      Int      @default(100)
  usedCount    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Community {
  id            String              @id @default(uuid())
  name          String
  slug          String              @unique
  description   String?             @db.Text
  coverImageUrl String?
  iconUrl       String?
  rules         String?             @db.Text
  visibility    CommunityVisibility @default(PUBLIC)
  joinPolicy    JoinPolicy          @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  members       CommunityMember[]
  posts         Post[]
  polls         Poll[]
  events        Event[]
  invitations   CommunityInvitation[]
  joinRequests  JoinRequest[]
}

model CommunityMember {
  id          String     @id @default(uuid())
  communityId String
  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole @default(COMMUNITY_MEMBER)
  joinedAt    DateTime   @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

model Post {
  id               String            @id @default(uuid())
  communityId      String
  community        Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId         String
  author           User              @relation(fields: [authorId], references: [id])
  postType         PostType          @default(DISCUSSION)
  title            String
  body             String            @db.Text
  isPinned         Boolean           @default(false)
  isClosed         Boolean           @default(false)
  suggestionStatus SuggestionStatus?
  bestAnswerId     String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  comments         Comment[]
  reactions        PostReaction[]
  media            Media[]

  @@index([communityId])
  @@index([authorId])
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    Comment?  @relation("NestedReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("NestedReplies")
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId])
  @@index([parentId])
}

model PostReaction {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction  String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Poll {
  id          String       @id @default(uuid())
  communityId String
  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  question    String
  expiresAt   DateTime?
  isClosed    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  options     PollOption[]
  votes       PollVote[]
}

model PollOption {
  id         String     @id @default(uuid())
  pollId     String
  poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionText String
  votes      PollVote[]
}

model PollVote {
  id       String     @id @default(uuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Event {
  id          String      @id @default(uuid())
  communityId String
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  description String      @db.Text
  startTime   DateTime
  endTime     DateTime
  venue       String
  meetingLink String?
  createdAt   DateTime    @default(now())

  rsvps       EventRSVP[]
}

model EventRSVP {
  id        String     @id @default(uuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RSVPStatus @default(GOING)
  createdAt DateTime   @default(now())

  @@unique([eventId, userId])
}

model Media {
  id        String   @id @default(uuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())
}

model CommunityInvitation {
  id           String    @id @default(uuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  invitedById  String
  invitedBy    User      @relation("InvitedBy", fields: [invitedById], references: [id])
  emailOrPhone String
  inviteCode   String    @unique
  isAccepted   Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
}

model JoinRequest {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String
  message     String?
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
}

model Complaint {
  id            String          @id @default(uuid())
  ticketNo      String          @unique
  complainantId String
  complainant   User            @relation("Complainant", fields: [complainantId], references: [id])
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id])
  type          ComplaintType
  subject       String
  description   String          @db.Text
  status        ComplaintStatus @default(OPEN)
  adminRemarks  String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([complainantId])
  @@index([status])
}

model Article {
  id              String       @id @default(uuid())
  slug            String       @unique
  title           String
  body            String       @db.Text
  category        NewsCategory
  authorName      String       @default("Steelsetu Editorial")
  isPublished     Boolean      @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  emailOrPhone String   @unique
  isWhatsApp   Boolean  @default(true)
  subscribedAt DateTime @default(now())
}
