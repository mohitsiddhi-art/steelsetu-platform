{
  "name": "steelsetu-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=@steelsetu/web",
    "dev:api": "npm run dev --workspace=@steelsetu/api",
    "build": "turbo run build",
    "build:web": "npm run build --workspace=@steelsetu/web",
    "lint": "turbo run lint",
    "db:generate": "npm run db:generate --workspace=@steelsetu/database",
    "db:push": "npm run db:push --workspace=@steelsetu/database",
    "db:seed": "npm run db:seed --workspace=@steelsetu/database"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5"
  }
}
