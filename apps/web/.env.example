# Steelsetu web app — environment template.
# Copy to `.env.local` for local development and fill in real values.
# NEVER commit `.env.local` or real secrets. This file holds placeholders only.

# ---- App ----
NEXT_PUBLIC_APP_NAME=Steelsetu
NEXT_PUBLIC_APP_URL=https://www.steelsetu.com

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- WhatsApp (public, used in links/QR) ----
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Admin / Staff ERP portals (server-side only) ----
# Login is checked on the server against these. Leave blank to disable that role.
ADMIN_EMAIL=
ADMIN_PASSWORD=
STAFF_EMAIL=
STAFF_PASSWORD=
# HMAC secret for signing the session cookie. Use a long random string
# (e.g. `openssl rand -base64 32`). Required for the portals to authenticate.
ADMIN_SESSION_SECRET=
